{
  "name": "schwalbe",
  "productName": "Schwalbe",
  "version": "0.4.1",
  "description": "Schwalbe – Schreiben, einfach. Der Word-Ersatz der Familie Selbst gfaltet, mit Claude als Helfer.",
  "author": "Nils Pohler",
  "main": "main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "bauen": "electron-builder --publish never"
  },
  "build": {
    "appId": "de.selbstgfaltet.schwalbe",
    "productName": "Schwalbe",
    "files": [
      "main/**",
      "kern/**",
      "ui/**",
      "bau/icon.png"
    ],
    "directories": {
      "output": "ausgabe",
      "buildResources": "bau"
    },
    "artifactName": "Schwalbe-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": [
          "docx"
        ],
        "name": "Dokument",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "bau/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Schwalbe",
      "createDesktopShortcut": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "bau/icon.png",
      "identity": "-",
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
