{
  "name": "kranich",
  "productName": "Kranich",
  "version": "0.8.1",
  "description": "Kranich aus der origami-Familie: Oberflächen entwerfen und Bilder bearbeiten, gesteuert per KI",
  "author": "Nils Pohler",
  "main": "main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "rauchtest": "electron werkzeug/rauch.js",
    "bauen": "electron-builder --publish never",
    "freisteller": "esbuild werkzeug/freisteller-quelle.js --bundle --format=iife --outfile=ui/vendor/freisteller.js --minify --log-level=warning"
  },
  "build": {
    "appId": "de.selbstgfaltet.kranich",
    "productName": "Kranich",
    "files": [
      "main/**",
      "kern/**",
      "ui/**",
      "bau/icon.png"
    ],
    "directories": {
      "output": "ausgabe",
      "buildResources": "bau"
    },
    "artifactName": "Kranich-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "bau/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Kranich"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "bau/icon.png",
      "identity": "-",
      "category": "public.app-category.graphics-design"
    },
    "asarUnpack": [
      "node_modules/@imgly/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ]
  },
  "devDependencies": {
    "@imgly/background-removal": "^1.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "onnxruntime-web": "^1.21.0"
  }
}
