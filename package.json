{
  "name": "kranich",
  "productName": "Kranich",
  "version": "0.3.1",
  "description": "Kranich, der Geräte-Wächter aus der origami-Familie",
  "author": "Nils Pohler",
  "main": "main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "rauchtest": "electron werkzeug/rauch.js",
    "oberflaeche": "python3 werkzeug/canvas-uebernehmen.py",
    "bauen": "electron-builder --publish never"
  },
  "dependencies": {
    "libyara-wasm": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "de.selbstgfaltet.kranich",
    "productName": "Kranich",
    "files": ["main/**", "kern/**", "ui/**", "bau/tray.png", "bau/icon.png", "zentrale/zugang.json"],
    "directories": { "output": "ausgabe", "buildResources": "bau" },
    "artifactName": "Kranich-${version}-${os}-${arch}.${ext}",
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "bau/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "Kranich" },
    "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "icon": "bau/icon.png", "identity": "-", "category": "public.app-category.utilities" }
  }
}
