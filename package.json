{
  "name": "kranich",
  "productName": "Kranich",
  "version": "0.1.0",
  "description": "Kranich, der Geräte-Wächter aus der origami-Familie",
  "main": "main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "rauchtest": "electron werkzeug/rauch.js",
    "bauen": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "de.selbstgfaltet.kranich",
    "productName": "Kranich",
    "files": [
      "main/**",
      "kern/**",
      "ui/**",
      "bau/tray.png"
    ],
    "directories": {
      "output": "ausgabe"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
