{
  "name": "kranich",
  "productName": "Kranich",
  "version": "0.4.0",
  "description": "Kranich, der Geräte-Wächter aus der origami-Familie: Kranich Agent und Kranich Host",
  "author": "Nils Pohler",
  "main": "main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:host": "electron .",
    "start:agent": "KRANICH_ROLLE=agent electron .",
    "test": "node --test",
    "rauchtest": "electron werkzeug/rauch.js",
    "oberflaeche": "python3 werkzeug/canvas-uebernehmen.py && python3 werkzeug/agent-uebernehmen.py",
    "bauen": "npm run bauen:agent && npm run bauen:host",
    "bauen:agent": "electron-builder --publish never --config installer-agent.json",
    "bauen:host": "electron-builder --publish never --config installer-host.json"
  },
  "dependencies": {
    "libyara-wasm": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
