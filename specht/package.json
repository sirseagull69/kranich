{
  "name": "specht",
  "productName": "Specht",
  "version": "0.5.0",
  "description": "Specht – der IT-Helfer. Klopft ab, merkt sich alles, ändert nichts. Familie Selbst gfaltet.",
  "author": "Nils Pohler",
  "main": "main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "bauen": "electron-builder --publish never"
  },
  "build": {
    "appId": "de.selbstgfaltet.specht",
    "productName": "Specht",
    "files": [
      "main/**",
      "kern/**",
      "ui/**",
      "bau/icon.png"
    ],
    "directories": {
      "output": "ausgabe",
      "buildResources": "bau"
    },
    "artifactName": "Specht-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "bau/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Specht",
      "createDesktopShortcut": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "bau/icon.png",
      "identity": "-",
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
