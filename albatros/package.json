{
  "name": "albatros",
  "productName": "Albatros",
  "version": "0.2.0",
  "description": "Albatros – Tabellen, einfach. Der Excel-Ersatz der Familie Selbst gfaltet, mit Claude als Helfer.",
  "author": "Nils Pohler",
  "main": "main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "bauen": "electron-builder --publish never"
  },
  "build": {
    "appId": "de.selbstgfaltet.albatros",
    "productName": "Albatros",
    "files": [
      "main/**",
      "kern/**",
      "ui/**",
      "bau/icon.png"
    ],
    "directories": {
      "output": "ausgabe",
      "buildResources": "bau"
    },
    "artifactName": "Albatros-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": [
          "xlsx",
          "csv"
        ],
        "name": "Tabelle",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "bau/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Albatros"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "bau/icon.png",
      "identity": "-",
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "exceljs": "^4.4.0"
  }
}
